#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/tomato-tunnel
NET=/usr/libexec/tomato-tunnel/net.sh

boot() {
	"$NET" down >/dev/null 2>&1
	config_load tomato-tunnel
	local autostart
	config_get_bool autostart main autostart 1
	[ "$autostart" = 1 ] || return 0
	start "$@"
}

start_service() {
	"$NET" down >/dev/null 2>&1
	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 15
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance
}

service_stopped() {
	"$NET" down >/dev/null 2>&1
	return 0
}

service_running_tt() {
	pgrep -f "$PROG run" >/dev/null 2>&1
}

reload_service() {
	service_running_tt || return 0
	stop
	start
}

