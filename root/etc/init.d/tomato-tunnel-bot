#!/bin/sh /etc/rc.common

START=96
STOP=09
USE_PROCD=1

PROG=/usr/bin/tomato-tunnel

start_service() {
	config_load tomato-tunnel
	local enabled token
	config_get_bool enabled bot enabled 0
	config_get token bot token ''
	[ "$enabled" = 1 ] && [ -n "$token" ] || return 0
	procd_open_instance
	procd_set_param command "$PROG" bot
	procd_set_param respawn 3600 10 0
	procd_set_param term_timeout 5
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	rm -f /var/run/tomato-tunnel/bot.json
	return 0
}

reload_service() {
	stop
	start
}
