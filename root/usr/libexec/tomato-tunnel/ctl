#!/bin/sh
RUN=/var/run/tomato-tunnel
BIN=/usr/bin/tomato-tunnel
INIT=/etc/init.d/tomato-tunnel
BANNER=/etc/tomato-tunnel/banner.img
WWW=/www/luci-static/tomato-tunnel

running() {
	[ -f "$RUN/status.json" ] || return 1
	pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$RUN/status.json")
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "$1" in
	status)
		if running; then cat "$RUN/status.json"; else echo '{"state":"stopped"}'; fi
		;;
	normalize)
		active=$(uci -q get tomato-tunnel.main.profile)
		changed=0
		for cid in $(uci -X show tomato-tunnel 2>/dev/null | sed -n 's/^tomato-tunnel\.\(cfg[0-9a-f]*\)=profile$/\1/p'); do
			n=1
			while uci -q get "tomato-tunnel.p$n" >/dev/null; do n=$((n + 1)); done
			uci rename "tomato-tunnel.$cid=p$n" || continue
			[ "$active" = "$cid" ] && uci set "tomato-tunnel.main.profile=p$n"
			changed=1
		done
		[ "$changed" = 1 ] && uci commit tomato-tunnel
		echo ok
		;;
	version)
		"$BIN" version
		;;
	xray-version)
		if [ -x /usr/libexec/tomato-tunnel/xray ]; then
			/usr/libexec/tomato-tunnel/xray version 2>/dev/null | head -n 1
		else
			echo ""
		fi
		;;
	xray-system)
		b=$(command -v xray 2>/dev/null)
		case "$b" in ''|/usr/libexec/tomato-tunnel/*) echo "" ;; *) "$b" version 2>/dev/null | head -n 1 ;; esac
		;;
	switch)
		case "$2" in ''|*[!A-Za-z0-9_]*) echo "bad profile"; exit 1 ;; esac
		[ "$(uci -q get "tomato-tunnel.$2")" = profile ] || { echo "profile not found"; exit 1; }
		uci set tomato-tunnel.main.profile="$2"
		uci commit tomato-tunnel
		if running; then
			echo "switch $2" >> "$RUN/cmd"
			kill -USR2 "$pid"
			echo switching
		else
			echo selected
		fi
		;;
	policy)
		case "$2" in manual|fallback|auto|balance) ;; *) echo "bad policy"; exit 1 ;; esac
		uci set tomato-tunnel.main.policy="$2"
		if [ "$2" = manual ]; then uci set tomato-tunnel.main.failover=0; else uci set tomato-tunnel.main.failover=1; fi
		uci commit tomato-tunnel
		if running; then
			echo "policy $2" >> "$RUN/cmd"
			kill -USR2 "$pid"
		fi
		echo ok
		;;
	cancel-switch)
		if running; then
			echo cancel >> "$RUN/cmd"
			kill -USR2 "$pid"
		fi
		echo ok
		;;
	latency)
		"$BIN" latency
		;;
	conns)
		touch "$RUN/conns.want"
		running || { echo '{"conns":[]}'; exit 0; }
		for i in 1 2 3; do
			[ -n "$(find "$RUN/conns.json" -newer "$RUN/conns.want" 2>/dev/null)" ] && break
			sleep 1
		done
		cat "$RUN/conns.json" 2>/dev/null || echo '{"conns":[]}'
		;;
	latency-cached)
		cat "$RUN/latency.json" 2>/dev/null || echo '{}'
		;;
	usage)
		if [ -s "$RUN/usage.json" ]; then cat "$RUN/usage.json"
		elif [ -s /etc/tomato-tunnel/usage.json ]; then cat /etc/tomato-tunnel/usage.json
		else echo '{"days":{},"months":{}}'; fi
		;;
	usage-reset)
		if running; then
			echo usage-reset >> "$RUN/cmd"
			kill -USR2 "$pid"
		else
			rm -f "$RUN/usage.json" /etc/tomato-tunnel/usage.json
		fi
		echo ok
		;;
	changeip)
		target=$(printf '%s' "$2" | tr -cd 'A-Za-z0-9_')
		if running; then
			echo "changeip $target" >> "$RUN/cmd"
			kill -USR2 "$pid"
		else
			mkdir -p "$RUN"
			if command -v setsid >/dev/null 2>&1; then
				( setsid "$BIN" changeip $target >/dev/null 2>&1 < /dev/null & ) >/dev/null 2>&1
			else
				( "$BIN" changeip $target >/dev/null 2>&1 < /dev/null & ) >/dev/null 2>&1
			fi
		fi
		echo started
		;;
	reload)
		if running; then
			echo reload-settings >> "$RUN/cmd"
			kill -USR2 "$pid"
			echo reloaded
		else
			echo stopped
		fi
		;;
	changeip-detect)
		"$BIN" changeip-detect
		;;
	start|stop|restart)
		"$INIT" "$1" >/dev/null 2>&1
		echo ok
		;;
	schedule-sync)
		/usr/bin/tomato-tunnel schedule-sync
		;;
	schedule-start|schedule-stop)
		what=${1#schedule-}
		echo "$(date +%H:%M:%S)  schedule Tunnel $( [ "$what" = start ] && echo on || echo off ) by schedule" >> "$RUN/tunnel.log"
		logger -t tomato-tunnel "schedule: tunnel $what"
		"$INIT" "$what" >/dev/null 2>&1
		echo ok
		;;
	log)
		tail -n "${2:-1000}" "$RUN/tunnel.log" 2>/dev/null
		;;
	clear-log)
		: > "$RUN/tunnel.log" 2>/dev/null
		running && kill -USR1 "$pid"
		echo ok
		;;
	test)
		[ -n "$2" ] || { echo '{"ok":false,"error":"no profile"}'; exit 1; }
		"$BIN" test "$2"
		;;
	update-check)
		"$BIN" update check
		;;
	update-install)
		mkdir -p "$RUN"
		echo "starting" > "$RUN/update.log"
		if command -v setsid >/dev/null 2>&1; then
			( setsid "$BIN" update install >> "$RUN/update.log" 2>&1 < /dev/null & ) >/dev/null 2>&1
		else
			( "$BIN" update install >> "$RUN/update.log" 2>&1 < /dev/null & ) >/dev/null 2>&1
		fi
		echo started
		;;
	update-log)
		cat "$RUN/update.log" 2>/dev/null
		;;
	xray-install|xray-remove)
		mkdir -p "$RUN"
		echo "starting" > "$RUN/xray.log"
		act=${1#xray-}
		if command -v setsid >/dev/null 2>&1; then
			( setsid "$BIN" xray "$act" >> "$RUN/xray.log" 2>&1 < /dev/null & ) >/dev/null 2>&1
		else
			( "$BIN" xray "$act" >> "$RUN/xray.log" 2>&1 < /dev/null & ) >/dev/null 2>&1
		fi
		echo started
		;;
	xray-log)
		cat "$RUN/xray.log" 2>/dev/null
		;;
	update-cached)
		cat "$RUN/update.json" 2>/dev/null || echo '{}'
		;;
	wanlist)
		for i in $(uci -q show network | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
			case "$i" in loopback|lan) continue;; esac
			echo "$i $(ifstatus "$i" 2>/dev/null | jsonfilter -q -e '@.l3_device')"
		done
		;;
	ifaces)
		for d in /sys/class/net/*; do
			n=${d##*/}
			case "$n" in lo|tt0|ifb*|teql*|gre*|ip6tnl*|sit*|erspan*) continue;; esac
			echo "$n"
		done
		;;
	banner-set)
		f=/tmp/tt-banner.upload
		[ -f "$f" ] || { echo "no upload"; exit 1; }
		size=$(wc -c < "$f")
		[ "$size" -le 524288 ] || { rm -f "$f"; echo "image is larger than 500 KB"; exit 1; }
		if command -v hexdump >/dev/null 2>&1; then
			magic=$(hexdump -n 4 -e '4/1 "%02x"' "$f" 2>/dev/null)
			case "$magic" in
				ffd8ff*|89504e47|52494646) ;;
				*) rm -f "$f"; echo "only JPG, PNG or WebP"; exit 1 ;;
			esac
		fi
		mkdir -p /etc/tomato-tunnel "$WWW"
		chmod 755 "$WWW"
		mv "$f" "$BANNER" && chmod 644 "$BANNER" || { echo "could not save the image"; exit 1; }
		rm -f "$WWW/banner.img"
		cp "$BANNER" "$WWW/banner.img" && chmod 644 "$WWW/banner.img" || { echo "could not publish the image"; exit 1; }
		echo ok
		;;
	banner-clear)
		rm -f "$BANNER" "$WWW/banner.img"
		echo ok
		;;
	bot-status)
		if [ -f "$RUN/bot.json" ]; then
			bpid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$RUN/bot.json")
			if [ -n "$bpid" ] && kill -0 "$bpid" 2>/dev/null; then cat "$RUN/bot.json"; else echo '{"state":"stopped"}'; fi
		else
			echo '{"state":"stopped"}'
		fi
		;;
	bot-pair)
		"$BIN" bot-pair
		;;
	bot-restart)
		/etc/init.d/tomato-tunnel-bot enable >/dev/null 2>&1
		/etc/init.d/tomato-tunnel-bot restart >/dev/null 2>&1
		echo ok
		;;
	bot-test)
		bpid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$RUN/bot.json" 2>/dev/null)
		if [ -n "$bpid" ] && kill -0 "$bpid" 2>/dev/null; then
			kill -USR1 "$bpid"
			echo sent
		else
			echo "bot is not running"
		fi
		;;
	*)
		echo "usage: $0 status|start|stop|restart|schedule-sync|schedule-start|schedule-stop|usage|usage-reset|reload|changeip|changeip-detect|switch <id>|policy <p>|cancel-switch|latency|latency-cached|conns|log|clear-log|test <id>|update-check|update-install|update-log|update-cached|xray-version|xray-system|xray-install|xray-remove|xray-log|ifaces|wanlist|banner-set|banner-clear|bot-status|bot-pair|bot-restart|bot-test" >&2
		exit 2
		;;
esac
